# Local Gophish on this PC, or remote: https://your-hostname:3333
GOPHISH_URL=https://127.0.0.1:3333
GOPHISH_API_KEY=paste-your-api-key-from-gophish-settings
# Routine API calls (page load, lists) — keep short so the UI stays responsive
GOPHISH_API_TIMEOUT=30
# Bulk import/create/verify — base timeout (scales up with user count)
GOPHISH_BULK_TIMEOUT=1200
# Hard cap per request (seconds)
GOPHISH_BULK_TIMEOUT_MAX=3600
# Extra seconds added to timeout per CSV row / group member
GOPHISH_BULK_PER_USER_SEC=0.75
# Pause between heavy API steps (seconds)
GOPHISH_COOLDOWN_SEC=5
# Pause before recheck pass and after full batch (seconds)
GOPHISH_COOLDOWN_FINAL_SEC=20
# Retries on connection/timeout/502/503 errors
GOPHISH_API_RETRIES=3
GOPHISH_RETRY_DELAY_SEC=12
FLASK_SECRET_KEY=change-me-in-production
